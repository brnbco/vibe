# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=SYSADMIN
# Auth: provide EITHER private key path (recommended) OR password
SNOWFLAKE_PRIVATE_KEY_PATH=snowflake_key.p8
SNOWFLAKE_PASSWORD=
# Comma-separated list of databases to crawl (empty = all non-system databases)
SNOWFLAKE_DATABASES=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX=semantic-compiler
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
